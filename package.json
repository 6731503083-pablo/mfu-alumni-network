    "db:remote": "wrangler d1 migrations apply alumni-network-db --remote",
    "cf-typegen": "wrangler types",
    "demo": "node scripts/demo.mjs",
    "demo:seed": "node scripts/seed.mjs",
    "evidence:team17": "node scripts/team17-evidence.mjs",
    "evidence:security": "node scripts/security-evidence.mjs"
  },
  "dependencies": {
    "hono": "^4.13.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.0",
    "@cloudflare/workers-types": "^5.20260822.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true
  }
