{
  "name": "alumni-network-integration",
  "version": "1.0.0",
  "private": true,
  "description": "MFU Alumni Network — Week 06 integration lab (A5): partner endpoint, webhook send/receive, idempotency.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
